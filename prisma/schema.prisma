datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         AdminRole  @default(EDITOR)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Announcement {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  excerpt       String?
  content       String        @db.Text
  category      String
  imageUrl      String?
  imagePublicId String?
  attachmentUrl String?
  isImportant   Boolean       @default(false)
  status        ContentStatus @default(PUBLISHED)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([publishedAt])
}

model Activity {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String        @db.Text
  excerpt       String?
  imageUrl      String?
  imagePublicId String?
  startDate     DateTime
  endDate       DateTime
  startTime     String
  endTime       String
  location      String
  organizer     String
  participants  String
  requirements  String?       @db.Text
  status        ContentStatus @default(PUBLISHED)
  isFeatured    Boolean       @default(false)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([startDate])
}

model NeighborhoodUnit {
  id              String        @id @default(cuid())
  number          String        @unique
  leaderName      String
  area            String?
  officeLocation  String?
  serviceHours    String?
  officialContact String?
  status          ContentStatus @default(PUBLISHED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

model Service {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String        @db.Text
  requirements  String?       @db.Text // Can be stored as JSON or bulleted text
  procedure     String?       @db.Text
  estimatedTime String?
  serviceHours  String?
  documentUrl   String?
  contact       String?
  icon          String?
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slug])
  @@index([status])
}

model Facility {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  category       String
  description    String        @db.Text
  imageUrl       String?
  imagePublicId  String?
  location       String
  operatingHours String?
  rules          String?       @db.Text
  mapUrl         String?
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
}

model Business {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  category       String
  description    String        @db.Text
  imageUrl       String?
  imagePublicId  String?
  address        String
  operatingHours String?
  whatsapp       String?
  socialMedia    String?       @db.Text // Store as JSON string or text
  status         ContentStatus @default(PUBLISHED)
  isFeatured     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
}

model GalleryItem {
  id            String        @id @default(cuid())
  title         String
  caption       String?       @db.Text
  category      String
  imageUrl      String
  imagePublicId String?
  eventDate     DateTime?
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([category])
}

model Document {
  id           String        @id @default(cuid())
  name         String
  description  String?       @db.Text
  category     String
  fileUrl      String
  filePublicId String?
  fileType     String?
  fileSize     String?
  status       ContentStatus @default(PUBLISHED)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([category])
}

model SecuritySchedule {
  id          String        @id @default(cuid())
  day         String
  shift       String
  startTime   String
  endTime     String
  location    String?
  description String?       @db.Text
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model CleaningSchedule {
  id          String        @id @default(cuid())
  title       String
  type        String
  day         String?
  date        String?
  startTime   String?
  location    String?
  description String?       @db.Text
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model SiteSetting {
  id           String   @id @default(cuid())
  siteName     String
  rwName       String
  description  String?  @db.Text
  address      String?
  phone        String?
  whatsapp     String?
  email        String?
  serviceHours String?
  instagram    String?
  mapUrl       String?  @db.Text
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  entityType  String
  entityId    String
  description String   @db.Text
  createdAt   DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([entityType])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model RwCashTransaction {
  id              String          @id @default(cuid())
  title           String
  description     String?         @db.Text
  amount          Float
  type            TransactionType
  category        String
  transactionDate DateTime
  receiptUrl      String?
  receiptPublicId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([type])
  @@index([category])
  @@index([transactionDate])
}
